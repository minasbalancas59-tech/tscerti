From 308ac29b2a05cc71d9635ea77a36be395a8375a2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jo=C3=A3o?= <minas.balancas59@gmail.com>
Date: Thu, 27 Aug 2026 16:19:47 +0000
Subject: [PATCH] Multi-intervalo: usa e da faixa 1 como referencia ao salvar

O campo 'Divisao e' unico fica oculto em multi-intervalo e por isso
vazio numa balanca nova, o que barrava o salvar com 'Divisao (e) deve
ser maior que zero'. Agora, ao salvar uma balanca multi-intervalo, o
divisaoE de referencia passa a ser o e da faixa 1 (a mais fina) e o
divisaoD nao e enviado. Bug encontrado em teste real na Empresa de
Testes.
---
 src/Api/wwwroot/app.js | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/Api/wwwroot/app.js b/src/Api/wwwroot/app.js
index ab565a0..6a02f34 100644
--- a/src/Api/wwwroot/app.js
+++ b/src/Api/wwwroot/app.js
@@ -10369,6 +10369,10 @@ async function salvarBalanca(clienteId, id) {
       $('#f-erro').textContent = `A última faixa vai até ${ultima}, mas a capacidade é ${cap}. Ajuste antes de salvar.`;
       return;
     }
+    // O campo "Divisão e" único fica oculto em multi-intervalo: usa como
+    // referência o "e" da faixa 1 (a mais fina) e não envia "d".
+    if (!corpo.divisaoE || corpo.divisaoE <= 0) corpo.divisaoE = faixas[0].divisaoE;
+    corpo.divisaoD = null;
   }
   try {
     const salva = await api(id ? '/balancas/' + id : `/clientes/${clienteId}/balancas`, {
-- 
