# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o .env no Git (já está no .gitignore).

# ── Banco ──────────────────────────────────────────────
DB_NAME=certsaas
DB_USER=certsaas
DB_PASSWORD=troque-esta-senha-forte

# ── Storage S3 / MinIO ────────────────────────────────
S3_ACCESS_KEY=certsaas-admin
S3_SECRET_KEY=troque-esta-senha-forte-tambem
S3_BUCKET=certificados

# ── JWT ────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres
JWT_ISSUER=certsaas

# ── SMTP ───────────────────────────────────────────────
# Em desenvolvimento aponta pro Mailpit; em produção, pro provedor real
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=certificados@suaempresa.com.br

# ── Usuário de banco da APLICAÇÃO (etapa 2) ───────────
# Criado pelo db/seed/10_app_role.sql — a senha aqui deve
# ser IDÊNTICA à editada naquele arquivo antes de rodá-lo
APP_DB_USER=api_app
APP_DB_PASSWORD=EDITE_AQUI_senha_do_api_app
